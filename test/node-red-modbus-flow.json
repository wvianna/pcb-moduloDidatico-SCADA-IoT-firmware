  {
    "id": "a100000000000004",
    "type": "function",
    "z": "f1a2b3c4d5e6f701",
    "name": "Decodificar DI",
    "func": "function decodeFromByteArray(data) {\n    if (!Array.isArray(data) || data.length === 0) return null;\n    const b = Number(data[0]) || 0;\n    return {\n        DI10001_base0_0: b & 0x01 ? 1 : 0,\n        DI10002_base0_1: b & 0x02 ? 1 : 0\n    };\n}\n\nlet decoded = null;\n\nif (msg.payload && Array.isArray(msg.payload.data)) {\n    decoded = decodeFromByteArray(msg.payload.data);\n}\n\nif (!decoded && msg.responseBuffer && Array.isArray(msg.responseBuffer.data)) {\n    decoded = decodeFromByteArray(msg.responseBuffer.data);\n}\n\nif (!decoded && Array.isArray(msg.payload) && msg.payload.length >= 2) {\n    decoded = {\n        DI10001_base0_0: msg.payload[0] ? 1 : 0,\n        DI10002_base0_1: msg.payload[1] ? 1 : 0\n    };\n}\n\nif (!decoded) {\n    msg.payload = {\n        erro: \"Nao foi possivel decodificar resposta\",\n        bruto: msg.payload\n    };\n    return msg;\n}\n\nmsg.payload = {\n    transporte: msg.transport || \"desconhecido\",\n    unitid: 1,\n    ...decoded\n};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
