[
  {
    "id": "opcua-client-reader",
    "type": "tab",
    "label": "Leitor OPC UA Client",
    "disabled": false,
    "info": "Le os valores do servidor OPC UA do NodeMCU a cada 3 segundos e exibe no debug."
  },
  {
    "id": "trigger-read",
    "type": "inject",
    "z": "opcua-client-reader",
    "name": "Ler a cada 3s",
    "repeat": "3",
    "crontab": "",
    "once": true,
    "onceDelay": "2",
    "topic": "",
    "payload": "",
    "payloadType": "none",
    "x": 150,
    "y": 100,
    "wires": [["read-nodemcu"]]
  },
  {
    "id": "read-nodemcu",
    "type": "opcua-client",
    "z": "opcua-client-reader",
    "name": "Ler nós do NodeMCU",
    "endpoint": "opc.tcp://192.168.100.200:4840",
    "action": "read",
    "signed": false,
    "deadband": 0,
    "timeout": 3000,
    "nodes": [
      "ns=1;s=Coil_0",
      "ns=1;s=Coil_1",
      "ns=1;s=DiscreteInput_0",
      "ns=1;s=DiscreteInput_1",
      "ns=1;s=ADC",
      "ns=1;s=DS18B20",
      "ns=1;s=PWM_Azimuth",
      "ns=1;s=PWM_Elevation",
      "ns=1;s=PWM_Heater"
    ],
    "x": 370,
    "y": 100,
    "wires": [["format-output"]]
  },
  {
    "id": "format-output",
    "type": "function",
    "z": "opcua-client-reader",
    "name": "Formatar saída",
    "func": "var out = {\n  timestamp: new Date().toISOString(),\n  node_id: msg.topic,\n  values: {}\n};\n\nif (Array.isArray(msg.payload)) {\n  msg.payload.forEach(function(item) {\n    var name = item.nodeId.split('=').pop();\n    out.values[name] = item.value;\n  });\n} else if (msg.payload) {\n  out.values[msg.topic] = msg.payload.value || msg.payload;\n}\n\n// Mensagem única consolidada\nvar consolidated = {\n  topic: 'nodemcu/opcua/readback',\n  payload: out\n};\n\n// Mensagens individuais para dashboard\nvar msgs = [];\nObject.keys(out.values).forEach(function(k) {\n  msgs.push({ topic: 'nodemcu/' + k, payload: out.values[k] });\n});\n\nreturn [consolidated].concat(msgs);",
    "outputs": 1,
    "x": 590,
    "y": 100,
    "wires": [["debug-output","debug-individual"]]
  },
  {
    "id": "debug-output",
    "type": "debug",
    "z": "opcua-client-reader",
    "name": "Consolidado",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "x": 810,
    "y": 80,
    "wires": []
  },
  {
    "id": "debug-individual",
    "type": "debug",
    "z": "opcua-client-reader",
    "name": "Individuais",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "x": 810,
    "y": 120,
    "wires": []
  },
  {
    "id": "http-read",
    "type": "http in",
    "z": "opcua-client-reader",
    "name": "GET /api/nodemcu",
    "url": "/api/nodemcu",
    "method": "get",
    "upload": false,
    "swaggerDoc": "",
    "x": 140,
    "y": 200,
    "wires": [["read-on-demand"]]
  },
  {
    "id": "read-on-demand",
    "type": "opcua-client",
    "z": "opcua-client-reader",
    "name": "Ler sob demanda",
    "endpoint": "opc.tcp://192.168.100.200:4840",
    "action": "read",
    "signed": false,
    "deadband": 0,
    "timeout": 3000,
    "nodes": [
      "ns=1;s=Coil_0",
      "ns=1;s=Coil_1",
      "ns=1;s=DiscreteInput_0",
      "ns=1;s=DiscreteInput_1",
      "ns=1;s=ADC",
      "ns=1;s=DS18B20",
      "ns=1;s=PWM_Azimuth",
      "ns=1;s=PWM_Elevation",
      "ns=1;s=PWM_Heater"
    ],
    "x": 370,
    "y": 200,
    "wires": [["format-http"]]
  },
  {
    "id": "format-http",
    "type": "function",
    "z": "opcua-client-reader",
    "name": "JSON HTTP",
    "func": "var now = new Date().toISOString();\nvar result = { timestamp: now, nodemcu: {} };\n\nif (Array.isArray(msg.payload)) {\n  msg.payload.forEach(function(item) {\n    var name = item.nodeId.split('=').pop();\n    result.nodemcu[name] = item.value;\n  });\n}\n\nmsg.payload = result;\nreturn msg;",
    "outputs": 1,
    "x": 600,
    "y": 200,
    "wires": [["http-response"]]
  },
  {
    "id": "http-response",
    "type": "http response",
    "z": "opcua-client-reader",
    "name": "Resposta HTTP",
    "statusCode": "200",
    "headers": { "Content-Type": "application/json" },
    "x": 810,
    "y": 200,
    "wires": []
  }
]
